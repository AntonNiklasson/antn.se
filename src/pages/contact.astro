---
import PageLayout from "../layouts/PageLayout.astro";
import ContactForm from "../components/ContactForm";
---

<PageLayout title="Contact" summary="Get in touch">
	<p class="mb-8 text-sm text-muted">
		Have a question or something to share? Send me a message below, or find me on
		<a
			href="https://x.com/antonniklasson"
			target="_blank"
			rel="noopener noreferrer"
			class="text-foreground hover:underline">X</a
		>
		or
		<a
			href="https://www.linkedin.com/in/antonniklasson"
			target="_blank"
			rel="noopener noreferrer"
            class="text-foreground hover:underline">LinkedIn
            </a>.
	</p>
	<ContactForm client:load />
</PageLayout>
